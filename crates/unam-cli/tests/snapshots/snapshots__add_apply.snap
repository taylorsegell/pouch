---
source: crates/unam-cli/tests/snapshots.rs
expression: v
---
{
  "ok": true,
  "command": "add",
  "data": {
    "command": "add",
    "project_root": "[TMP]/work/p",
    "root_detection": "git",
    "target": "claude-code",
    "destination": ".claude/skills",
    "strategy": "symlink",
    "detection": "absent",
    "status": "applied",
    "op_id": "[OP_ID]",
    "selection": {
      "written": true,
      "path": "[TMP]/work/p/.unam/selection.yaml",
      "bundles": [],
      "add": [
        "fx:sdlc/code-review",
        "fx:testing/pytest-fixtures"
      ],
      "remove": []
    },
    "plan": {
      "steps": [
        {
          "n": 1,
          "op": "add",
          "id": "fx:sdlc/code-review",
          "name": "code-review",
          "dest": ".claude/skills/code-review",
          "strategy": "symlink",
          "source": "[TMP]/work/lib/sdlc/code-review",
          "provenance": [
            {
              "adhoc": true
            }
          ]
        },
        {
          "n": 2,
          "op": "add",
          "id": "fx:testing/pytest-fixtures",
          "name": "pytest-fixtures",
          "dest": ".claude/skills/pytest-fixtures",
          "strategy": "symlink",
          "source": "[TMP]/work/lib/testing/pytest-fixtures",
          "provenance": [
            {
              "adhoc": true
            }
          ]
        }
      ],
      "unchanged": [],
      "carried": [],
      "conflicts": [],
      "warnings": [],
      "estimate": {
        "skills": 2,
        "tokens": 70,
        "estimate": true
      }
    },
    "results": [
      {
        "n": 1,
        "op": "add",
        "name": "code-review",
        "result": "done",
        "code": null,
        "message": null
      },
      {
        "n": 2,
        "op": "add",
        "name": "pytest-fixtures",
        "result": "done",
        "code": null,
        "message": null
      }
    ],
    "receipt": {
      "path": "[TMP]/work/p/.unam/claude-code/applied.json",
      "entries": 2,
      "last_op_id": "[OP_ID]"
    },
    "refresh": {
      "kind": "command",
      "command": "/reload-skills",
      "text": "this apply created the skills directory; run /reload-skills in a running Claude Code session so it scans it (evidence: https://code.claude.com/docs/en/skills)",
      "evidence": "https://code.claude.com/docs/en/skills"
    },
    "followups": [],
    "removal_caveat": null,
    "gitignore_lines": [
      ".unam/lock",
      ".unam/*/applied.json",
      ".unam/*/journal.jsonl",
      ".unam/*/history/",
      ".unam/*/trash/"
    ],
    "visible_to": [
      "claude-code",
      "cursor (compat read)",
      "windsurf-devin (when Claude config reading is enabled)"
    ]
  },
  "warnings": [],
  "errors": []
}
